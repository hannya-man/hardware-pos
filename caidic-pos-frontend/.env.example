# For running the app on this computer (npm run dev). Copy this file to
# .env.local and fill it in from the Supabase project: the Connect button, or
# Project Settings > API. Both values are public by design; the published
# site gets them from the repository's Actions secrets instead.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
