# Dependencies
node_modules/

# Environment variables — Supabase URL/keys, etc. Never commit these.
.env
.env.local
.env.*.local

# Build output
dist/
.vite/

# Copies of the app's modules made by the tests
tests/.app-under-test/
tests/.app-under-test-ui/

# Decrypted database backups (keep them off the repository)
pos-backup-*

# Android app packages and the key that signs them. The repository is public,
# and anyone with the key could publish an "update" to the app.
RRC POS - Google Play package/
*.keystore
*.jks
*.apk
*.aab
*.idsig
keystore-password.txt

